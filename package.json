{
  "name": "circuit-nova",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "check": "bun run test && bun run typecheck && bun run build",
    "check:full": "bun run check && bun run test:e2e",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "build:templates": "bun run scripts/build-templates.ts",
    "verify:templates": "bun run scripts/verify-templates.ts",
    "nova": "bun run packages/nova-cli/src/nova.ts",
    "build:cli": "bun run scripts/build-cli.ts",
    "build:packages": "bun run scripts/build-packages.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@convex-dev/better-auth": "^0.12.5",
    "better-auth": "~1.6.15",
    "convex": "^1.31.2",
    "e2b": "^2.36.0",
    "lucide-react": "^1.29.0",
    "next": "^16.0.0",
    "openai": "^6.49.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-resizable-panels": "^4.12.2",
    "zod": "^4.4.3",
    "@circuit-nova/nova-core": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "3.2.7",
    "node-pty": "^1.1.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "bin": {
    "nova": "./dist/nova.js"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ]
}
