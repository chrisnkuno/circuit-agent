{
  "name": "nova-desktop",
  "version": "0.3.1",
  "private": true,
  "description": "Nova Desktop — a Tauri 2 desktop app for the Nova coding agent, with parallel tabs, guarded approvals, git checkpoints and real cost accounting.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrisnkuno/nova-desktop.git"
  },
  "bugs": {
    "url": "https://github.com/chrisnkuno/nova-desktop/issues"
  },
  "homepage": "https://github.com/chrisnkuno/nova-desktop#readme",
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check": "bun run test && bun run typecheck && bun run build",
    "test": "vitest run",
    "test:bun": "bun test",
    "typecheck": "tsc -b && tsc -p sidecar/tsconfig.json --noEmit",
    "sidecar:build": "tsc -p sidecar/tsconfig.json",
    "sidecar:dev": "tsx sidecar/src/index.ts",
    "sidecar:binary": "bun run scripts/build-sidecar-binary.ts",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "package:windows": "node scripts/package-windows.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@circuit-nova/nova-core": "^0.12.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-process": "^2",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "clsx": "^2.1.1",
    "e2b": "^2.36.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.11.2",
    "@tauri-apps/cli": "^2.8.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "happy-dom": "^20.11.2",
    "tsx": "^4.20.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
