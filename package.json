{
  "name": "@circuit-nova/nova-desktop",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "sidecar:build": "tsc -p sidecar/tsconfig.json",
    "sidecar:dev": "tsx sidecar/src/index.ts",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "package:windows": "node scripts/package-windows.mjs",
    "tauri:build": "tauri build",
    "typecheck": "tsc -b && tsc -p sidecar/tsconfig.json --noEmit",
    "sidecar:binary": "bun run scripts/build-sidecar-binary.ts"
  },
  "dependencies": {
    "@circuit-nova/nova-core": "workspace:*",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-store": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "e2b": "^2.36.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "tsx": "^4.20.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
