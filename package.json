{
  "name": "circuit-nova",
  "version": "0.2.0",
  "private": true,
  "description": "Circuit-Nova monorepo: the Nova agent core and CLI, the hosted control plane, and the tooling that builds, releases and measures them.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrisnkuno/circuit-agent.git"
  },
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter @circuit-nova/web dev",
    "build": "bun run --filter @circuit-nova/web build",
    "start": "bun run --filter @circuit-nova/web start",
    "check": "bun run test && bun run typecheck && bun run build",
    "check:full": "bun run check && bun run test:e2e",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "bun run --filter @circuit-nova/web test:e2e",
    "typecheck": "tsc --noEmit && bun run --filter @circuit-nova/web typecheck",
    "nova": "bun run packages/nova-cli/src/nova.ts",
    "build:cli": "bun run tooling/build/build-cli.ts",
    "build:packages": "bun run tooling/build/build-packages.ts",
    "build:templates": "bun run tooling/build/build-templates.ts",
    "verify:templates": "bun run tooling/build/verify-templates.ts",
    "build:state": "cargo build --release --manifest-path packages/nova-state/Cargo.toml --bin nova-state",
    "test:state": "cargo test --manifest-path packages/nova-state/Cargo.toml",
    "bench": "bun run tooling/bench/bench.ts",
    "bench:state": "cargo run --release --features benchmark --manifest-path packages/nova-state/Cargo.toml --bin nova-state-bench -- --sessions 500 --messages 40 --queries 200",
    "bench:defender": "cargo run --release --features benchmark --manifest-path packages/nova-state/Cargo.toml --bin nova-defender-brain-bench -- --records 10000 --queries 2000",
    "bench:defender-feed": "bun run tooling/defender/bench-defender-feed.ts",
    "optimize:map": "bun run tooling/bench/optimization-report.ts",
    "defender:refresh": "bun --env-file=apps/web/.env.local run tooling/defender/refresh-defender-brain.ts",
    "defender:feed-key": "bun run tooling/defender/generate-defender-feed-key.ts",
    "reliability:audit": "bun run tooling/reliability/reliability-audit.ts",
    "reliability:exa": "bun run tooling/reliability/exa-reliability.ts",
    "reliability:rescore": "bun run tooling/reliability/reliability-rescore.ts",
    "reliability:scheduled": "bun run tooling/reliability/reliability-eval.ts",
    "reliability:promote": "bun run tooling/reliability/reliability-promote.ts",
    "reliability:publish": "bun run tooling/reliability/reliability-publish.ts"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@termuijs/testing": "^0.1.7",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "3.2.7",
    "e2b": "^2.39.0",
    "node-pty": "^1.1.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
