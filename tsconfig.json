{
  "//": "The workspace root: the shared packages, the tooling that builds and releases them, and the reliability site. Each app owns its own tsconfig (see apps/web/tsconfig.json) — `bun run typecheck` at the root runs both.",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "es2022"],
    "jsx": "react-jsx",
    "paths": {
      "@circuit-nova/nova-core": ["./packages/agent-core/src/index.ts"],
      "@circuit-nova/nova-core/*": ["./packages/agent-core/src/*"]
    }
  },
  "include": [
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "tooling/**/*.ts",
    "reliability/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules",
    "**/dist",
    "packages/nova-state/target"
  ]
}
