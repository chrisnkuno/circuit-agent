# Durable control plane
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
CONNECTOR_VAULT_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/connectors/google-calendar/callback
GOOGLE_CALENDAR_WEBHOOK_URL=

# Repository provisioning (GitHub App)
# Create a GitHub App with a Setup URL of NEXT_PUBLIC_SITE_URL + /api/connectors/github/callback
# and a Webhook URL of the Convex site URL + /github/webhook, subscribed to the
# installation and installation_repositories events.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# PEM-encoded App private key; keep multi-line values quoted when setting via `convex env set`.
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Coding execution
E2B_API_KEY=
E2B_CODING_TEMPLATE=
E2B_BROWSER_TEMPLATE=
E2B_DATA_TEMPLATE=
# Keep false until a reviewed egress policy is in place.
E2B_ALLOW_INTERNET=false
# Sandbox lifecycle webhooks (https://e2b.dev/docs/sandbox/lifecycle-events-webhooks). Register
# the endpoint once with the same secret you set here, then E2B pushes sandbox events instead of
# this system polling for them:
#   curl -X POST https://api.e2b.app/events/webhooks \
#     -H "X-API-Key: $E2B_API_KEY" -H "content-type: application/json" \
#     -d '{"name":"circuit-nova","url":"<Convex site URL>/e2b/webhook","enabled":true,
#          "events":["sandbox.lifecycle.created","sandbox.lifecycle.killed"],
#          "signatureSecret":"<the value below>"}'
# Unset, the endpoint rejects every delivery rather than trusting unsigned input.
E2B_WEBHOOK_SECRET=
# Second, interchangeable sandbox backend behind the same InteractiveCodingSandboxProvider
# contract. Not yet selected by any deployed dispatcher path; set CODING_SANDBOX_PROVIDER=docker
# to use it once a caller is wired to lib/providers/factory.ts's createCodingSandboxProvider.
CODING_SANDBOX_PROVIDER=e2b
DOCKER_CODING_IMAGE=
DOCKER_ALLOW_INTERNET=false
# Explicit selection only — never inferred from whichever credential happens to be set.
CODING_MODEL_PROVIDER=
OPENAI_API_KEY=
# Current balanced example; pin deliberately and re-evaluate with coding evals.
OPENAI_MODEL=gpt-5.6-terra
CIRCUITNOTION_API_KEY=
CIRCUITNOTION_BASE_URL=https://api.circuitnotion.com/v1
# Pin deliberately; CircuitNotion also proxies third-party models under the same API.
CIRCUITNOTION_MODEL=circuit-3
# Optional: if CircuitNotion's Cloudflare protection blocks Convex Cloud's shared egress IPs
# (it does at the time of writing — see docs/gap-register.md), deploy cloudflare/circuitnotion-relay
# and set CIRCUITNOTION_BASE_URL above to its URL + /v1 (e.g. https://circuitnotion-relay.<subdomain>.workers.dev/v1)
# instead of calling CircuitNotion directly. CIRCUITNOTION_RELAY_SECRET must then match the
# relay's own RELAY_SHARED_SECRET, which rejects every request without it.
CIRCUITNOTION_RELAY_SECRET=
# Version these rates with provider pricing and the RWF conversion used for quoting.
MODEL_INPUT_RWF_PER_MILLION=
MODEL_OUTPUT_RWF_PER_MILLION=

# Payment activation; keep disabled until the real API and webhook contract are verified
CIRCUIT_PAY_API_KEY=
CIRCUIT_PAY_WEBHOOK_SECRET=

# Development-only bypasses that let the /terminal UI exercise the real dispatcher end to
# end before Circuit Pay is verified. Both default to disabled; never enable either on a
# deployment that could be reached by anyone other than trusted developers, since an owner
# who enables them can authorize a task's cap without a real payment.
ALLOW_TERMINAL_LIVE_EXECUTION=false
ALLOW_DEV_PAYMENT_BYPASS=false

# Multi-interface task supervision: create a bot with @BotFather, set the webhook to
# <Convex site URL>/telegram/webhook with this same secret token, then link a chat from
# the web app ("Link Telegram") and send /link <code> to the bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Email notifications (Resend). Unset, lifecycle email is silently skipped rather than failing
# the runs that trigger it. RESEND_FROM must be an address on a domain verified with Resend.
RESEND_API_KEY=
RESEND_FROM=
